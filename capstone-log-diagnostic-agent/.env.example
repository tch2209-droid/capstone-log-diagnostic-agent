# Core
LOG_ROOT=C:/AI_Repo/logs
MAX_STEPS=12
MAX_TOOL_CALLS=10
MAX_DURATION_SECONDS=180
MAX_RETRIES=2
MAX_BRANCHES=3
MAX_BRANCH_DEPTH=3
MAX_LOG_BYTES=5242880
MAX_SOURCE_BYTES=1048576
AUDIT_LOG=./data/agent_audit.jsonl
AGENT_INSTRUCTIONS_FILE=./agentinstructions.json
# Optional override; defaults to the five C:/AI_Repo projects documented in README.
# PROJECT_ROOTS_JSON={"AddressStandardizationAPI":"C:/AI_Repo/AddressStandardizationAPI"}

# Live LLM mode (optional)
OPENAI_API_KEY=
LLM_MODEL=gpt-5.3-codex
LLM_REASONING_EFFORT=medium

# PostgreSQL / pgvector (optional)
DATABASE_URL=
# Supabase PostgreSQL stores durable LangGraph checkpoints. Percent-encode special
# characters in the password. Use the Supavisor session-mode URL on IPv4-only hosts.
CHECKPOINT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wqdiejoqudysfxmouvfu.supabase.co:5432/postgres?sslmode=require
LANGGRAPH_STRICT_MSGPACK=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_PGVECTOR=true
REQUIRE_HUMAN_REVIEW=true

# SignalDesk human review console. Keep the UI running before starting the agent.
SIGNALDESK_UI_URL=http://localhost:3000
SIGNALDESK_REVIEW_POLL_SECONDS=2
SIGNALDESK_ORCHESTRATION_UI_ENABLED=true
SIGNALDESK_ORCHESTRATION_STEP_DELAY_SECONDS=1

# Atlassian Rovo MCP. OAuth opens Atlassian sign-in in the browser when the
# LangGraph Jira node first runs. Use api_token only for non-interactive runs.
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
ATLASSIAN_MCP_AUTH_MODE=oauth
# Keep this stable so the dynamically registered MCP client and redirect URI match.
ATLASSIAN_OAUTH_CALLBACK_PORT=8765
ATLASSIAN_CLOUD_ID=55cf3312-005c-4d84-b3f0-3eba12acd901
ATLASSIAN_MCP_EMAIL=approver@example.com
# Personal token authentication must be enabled by the Atlassian organization admin.
# Create a scoped Rovo MCP token owned by the email above with:
# read:jira:agent-interface, write:jira:agent-interface, search:jira:agent-interface
ATLASSIAN_MCP_API_TOKEN=replace-with-a-scoped-atlassian-api-token
ATLASSIAN_SEARCH_TOOL=searchAtlassian
ATLASSIAN_FETCH_TOOL=fetchAtlassian
ATLASSIAN_JIRA_PROJECT_KEY=SCRUM
ATLASSIAN_JIRA_SITE_URL=https://agentic-dev-tacme.atlassian.net
ATLASSIAN_JIRA_ISSUE_TYPE=Task
ATLASSIAN_JIRA_CREATE_TOOL=createJiraIssue
ATLASSIAN_JIRA_SEARCH_TOOL=searchJiraIssuesUsingJql

# Shared secret used only between the UI server route and Python review handoff.
SIGNALDESK_REVIEW_API_TOKEN=replace-with-a-long-random-value
